---
import { render } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Base from '@layouts/Base.astro';
import Block from '@components/Block.astro';
import BodyLink from '@components/BodyLink.astro';
import { getVisibleArticles } from '@lib/utils';

export const getStaticPaths = (async () => {
	const articles = await getVisibleArticles();
	return articles.map((article) => ({
		params: { slug: article.id },
		props: article
	}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const article = Astro.props;
const { Content } = await render(article);
---

<Base title={article.data.title} description={article.data.description} {article}>
	<article title={article.data.title} class="flex flex-col gap-2">
		<nav class="contents">
			<Block>
				<BodyLink href="/blog" class="text-lg">My Other Posts</BodyLink>
			</Block>
		</nav>
		<header class="contents">
			<Block
				title={article.data.title}
				description={article.data.description}
				published={article.data.created}
				largeHeadings
			/>
		</header>
		<div
			class:list={[
				'contents',
				'[&_p]:py-1',
				'[&_h1]:py-4',
				'[&_h2]:py-3',
				'[&_h2]:text-3xl',
				'[&_h2]:font-semibold',
				'[&_h3]:py-3',
				'[&_h3]:text-3xl',
				'[&_h3]:font-semibold',
				'[&_figure]:my-2',
				'[&_.expressive-code]:my-2',
				'[&_:not(pre)>code]:bg-page',
				'[&_:not(pre)>code]:px-1',
				'[&_:not(pre)>code]:text-sm',
				'[&_h1_code]:text-3xl',
				'[&_h2_code]:text-2xl',
				'[&_h3_code]:text-2xl',
				'[&_ul]:list-inside',
				'[&_ul]:list-disc',
				'[&_li]:py-1'
			]}
		>
			<Block tags={article.data.tags} id="article">
				<Content />
			</Block>
		</div>
	</article>
</Base>
