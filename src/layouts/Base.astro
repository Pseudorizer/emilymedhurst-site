---
import BaseHead from '@components/BaseHead.astro';
import Navbar from '@components/Navbar/Navbar.astro';
import { CODE_THEMES } from '@lib/site';
import { Head } from 'astro-capo';
import { type Props as SeoProps } from 'astro-seo';
import type { CollectionEntry } from 'astro:content';

import '@src/base.css';

interface Props {
	title: string;
	description: string;
	article?: CollectionEntry<'articles'>;
	seo?: SeoProps;
}
const { title, description, seo, article } = Astro.props;
---

<html class="dark" data-theme={CODE_THEMES.dark} lang="en">
	<Head>
		<BaseHead {title} {description} {seo} {article} />
	</Head>
	<body class="mx-auto h-full max-w-4xl p-6 text-ink">
		<script is:inline define:vars={{ CODE_THEMES }}>
			// Only an explicit choice from the theme toggle is saved; otherwise the
			// OS preference is followed on every visit.
			const theme =
				window.localStorage.getItem('theme') ??
				(window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');

			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
				document.documentElement.dataset.theme = CODE_THEMES.light;
			}
		</script>
		<Navbar />
		<main class="pt-4">
			<slot />
		</main>
	</body>
</html>
