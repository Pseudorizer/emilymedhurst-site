---
import TablerMoon from '~icons/tabler/moon';
import TablerSun from '~icons/tabler/sun';
import { cn } from '@lib/cn';
---

<button
	id="theme-toggle"
	type="button"
	class={cn(
		'rounded-xl p-1 hover:cursor-pointer hover:bg-lightHighlight focus-visible:bg-lightHighlight dark:hover:bg-darkHighlight dark:focus-visible:bg-darkHighlight'
	)}
	aria-label="Toggle theme"
>
	<TablerMoon id="moon-icon" class="text-[2.25rem] md:text-[2rem]" data-hide="true" />
	<TablerSun id="sun-icon" class="text-[2.25rem] md:text-[2rem]" data-hide="true" />
</button>

<style>
	svg[data-hide='true'] {
		display: none;
	}
</style>

<script is:inline>
	const root = document.documentElement;
	const body = document.body;
	const sunIcon = document.querySelector('#sun-icon');
	const moonIcon = document.querySelector('#moon-icon');
	const themeToggle = document.querySelector('#theme-toggle');

	// The icon and label show the theme a click will switch to.
	const syncToggle = (isDarkMode) => {
		sunIcon.dataset.hide = String(!isDarkMode);
		moonIcon.dataset.hide = String(isDarkMode);
		const label = isDarkMode ? 'Switch to light theme' : 'Switch to dark theme';
		themeToggle.setAttribute('aria-label', label);
		themeToggle.title = label;
	};

	if (sunIcon && moonIcon && themeToggle) {
		syncToggle(root.classList.contains('dark'));

		themeToggle.addEventListener('click', () => {
			const isDarkMode = root.classList.toggle('dark');
			body.classList.toggle('dark', isDarkMode);
			root.dataset.theme = isDarkMode ? 'catppuccin-mocha' : 'catppuccin-latte';
			window.localStorage.setItem('theme', isDarkMode ? 'dark' : 'light');
			syncToggle(isDarkMode);
		});
	}
</script>
