---
import { cn } from '@lib/cn';

interface Props {
	src: string;
	/** Caption shown under the video. */
	alt: string;
	muted?: boolean;
}

const { src, alt, muted = true } = Astro.props;
---

<figure class={cn('flex justify-center py-2')}>
	<div class={cn('max-w-full rounded-lg border-2 border-dark dark:border-light')}>
		<video
			class={cn('h-auto max-w-full rounded-md')}
			{src}
			controls
			playsinline
			preload="metadata"
			{muted}></video>
		<figcaption class={cn('p-2 text-center')}>{alt}</figcaption>
	</div>
</figure>
