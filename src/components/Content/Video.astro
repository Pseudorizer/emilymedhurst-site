---

interface Props {
	src: string;
	/** Caption shown under the video. */
	alt: string;
	muted?: boolean;
}

const { src, alt, muted = true } = Astro.props;
---

<figure class="flex justify-center py-2">
	<div class="max-w-full rounded-lg border-2 border-ink">
		<video
			class="h-auto max-w-full rounded-md"
			{src}
			controls
			playsinline
			preload="metadata"
			{muted}></video>
		<figcaption class="p-2 text-center">{alt}</figcaption>
	</div>
</figure>
