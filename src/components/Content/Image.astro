---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
	src: ImageMetadata;
	description?: string;
	alt: string;
	eager?: boolean;
	height?: number;
	width?: number;
}

const { src, alt, description, eager, width, height } = Astro.props;
const caption = description ?? alt;
---

<figure class="flex flex-col justify-center rounded-lg border-2 border-ink bg-page">
	<Picture
		{src}
		{alt}
		{width}
		{height}
		layout="constrained"
		loading={eager ? 'eager' : 'lazy'}
		formats={['avif', 'webp', 'jpg']}
		pictureAttributes={{ class: 'flex justify-center' }}
		class="rounded-t-md"
	/>
	{/* Hide a caption that just repeats the alt text, so screen readers don't read it twice. */}
	<figcaption
		class="rounded-b-lg bg-surface p-2 text-center"
		aria-hidden={caption === alt ? 'true' : undefined}
	>
		{caption}
	</figcaption>
</figure>
