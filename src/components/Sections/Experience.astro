---
import Block from '@components/Block.astro';
import Section from '@components/Section.astro';
import { tags } from '@lib/tags';
---

<Section title="Experience">
	<div class="grid grid-cols-1 gap-2">
		<Block
			title="Track24"
			description="Currently working as a product engineer at Track24, primarily on their flagship product AtlasNXT."
			subheading="October 2025-Present"
			tags={[tags.react, tags.typescript, tags.tailwind, tags.nextjs, 'elixir', 'phoenix']}
			link="https://www.track24.com/"
		/>
		<Block
			title="Radweb"
			description="This was my first hire! I worked as a fullstack developer on InventoryBase."
			subheading="June 2022-August 2023 (placement), July 2024-October 2025"
			tags={[
				tags.react,
				tags.php,
				tags.laravel,
				tags.mysql,
				tags.redux,
				tags.typescript,
				'real customers'
			]}
			link="https://radweb.com/"
		/>
	</div>
</Section>
