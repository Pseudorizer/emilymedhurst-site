---
import Block from '@components/Block.astro';
import Section from '@components/Section.astro';
import { getVisibleArticles } from '@lib/utils';

/** How many of the newest posts the homepage shows. */
const POST_LIMIT = 5;

const articles = await getVisibleArticles();
---

{/* The slot is the "See more" link; the section is skipped when there are no posts. */}
{articles.length > 0 && (
	<Section title="Posts">
		{articles.slice(0, POST_LIMIT).map((article) => (
			<Block
				title={article.data.title}
				description={article.data.description}
				link={`/blog/${article.id}`}
				tags={article.data.tags}
			/>
		))}
		<slot />
	</Section>
)}
