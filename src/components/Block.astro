---
import dayjs from 'dayjs';
import AdvancedFormat from 'dayjs/plugin/advancedFormat';
import BodyLink from './BodyLink.astro';
import { cn } from '@lib/cn';
import type { Tag } from '@lib/types';
dayjs.extend(AdvancedFormat);

interface Props {
	title?: string;
	subheading?: string;
	/** Renders a "Posted on" line with a machine-readable <time>. */
	published?: Date;
	description?: string;
	link?: string;
	tags?: (Tag | string)[];
	class?: string;
	id?: string;
	largeHeadings?: boolean;
	headingLevel?: 1 | 2 | 3;
}

const {
	title = '',
	subheading = '',
	published,
	description = '',
	link = '',
	tags = [],
	class: className = '',
	id,
	largeHeadings,
	headingLevel = largeHeadings ? 1 : 3
} = Astro.props;

const Wrapper = title ? 'section' : 'div';
const Heading = `h${headingLevel}` as const;
---

<Wrapper
	class={cn('flex flex-col rounded-xl bg-lightHighlight p-2 dark:bg-darkHighlight', className)}
	{id}
>
	<slot />
	{
		title && (
			<Heading class={largeHeadings ? 'text-4xl font-semibold' : 'text-2xl font-normal'}>
				{link ? <BodyLink href={link}>{title}</BodyLink> : title}
			</Heading>
		)
	}
	{
		(subheading || published) && (
			<p class={largeHeadings ? 'mb-1 text-sm font-medium' : 'mb-1 text-xs'}>
				{subheading}
				{published && (
					<>
						Posted on{' '}
						<time datetime={published.toISOString()}>
							{dayjs(published).format('Do MMMM YYYY [at] HH:mm')}
						</time>
					</>
				)}
			</p>
		)
	}
	{description && <p>{description}</p>}
	{
		tags.length > 0 && (
			<footer class={cn('mt-2.5 flex flex-wrap gap-x-1 gap-y-2')}>
				{tags.map((tag) => {
					let Icon;

					if (typeof tag !== 'string') {
						Icon = tag.icon;
					}

					return typeof tag === 'string' ? (
						<>
							<div
								class={cn(
									'flex items-center rounded-2xl border-2 border-gray-600 p-1 px-2 dark:border-gray-500 '
								)}
							>
								<p class={cn('text-sm')}>{tag}</p>
							</div>
						</>
					) : (
						<>
							<div
								class={cn(
									'flex items-center gap-1 rounded-2xl border-2 border-gray-600 p-1 px-2 dark:border-gray-500'
								)}
							>
								<Icon style="font-size: 1.25rem" />
								<p class={cn('text-sm')}>{tag.text}</p>
							</div>
						</>
					);
				})}
			</footer>
		)
	}
</Wrapper>
