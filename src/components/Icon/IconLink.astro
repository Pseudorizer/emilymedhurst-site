---
import type { JSX } from 'astro/jsx-runtime';
import { cn } from '@lib/cn';
import { isSameSite } from '@lib/utils';

interface Props {
	icon: JSX.Element;
	href: string;
	iconSize?: string;
	ariaLabel: string;
	colour?: string;
	sameSite?: boolean;
	rel?: string;
}

let { sameSite = undefined } = Astro.props;
const {
	icon: Icon,
	href,
	ariaLabel,
	iconSize = '1.75rem',
	colour = 'currentColor',
	rel = ''
} = Astro.props;

if (sameSite === undefined) {
	sameSite = isSameSite(href);
}
---

<a
	{href}
	target={sameSite ? '' : '_blank'}
	rel={sameSite ? rel : `noreferrer noopener ${rel}`}
	class={cn(
		'flex w-min items-center rounded-xl p-1 hover:bg-lightHighlight hover:text-lightStandout focus-visible:bg-lightHighlight focus-visible:text-lightStandout dark:hover:bg-darkHighlight dark:hover:text-darkStandout dark:focus-visible:bg-darkHighlight dark:focus-visible:text-darkStandout'
	)}
	aria-label={ariaLabel}
	title={ariaLabel}
>
	<Icon style={`font-size: ${iconSize}; color: ${colour}`} />
</a>
