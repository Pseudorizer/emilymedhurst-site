---
import type { IconComponent } from '@lib/types';
import { linkAttributes } from '@lib/utils';

interface Props {
	icon: IconComponent;
	href: string;
	ariaLabel: string;
	rel?: string;
}

const { icon: Icon, href, ariaLabel, rel } = Astro.props;
---

<a
	{href}
	{...linkAttributes(href, rel)}
	class="flex w-min items-center rounded-xl p-1 hover:bg-surface hover:text-accent focus-visible:bg-surface focus-visible:text-accent"
	aria-label={ariaLabel}
	title={ariaLabel}
>
	<Icon class="text-[1.75rem]" />
</a>
