---
import { cn } from '@lib/cn';
import { isExternalLink, linkAttributes } from '@lib/utils';

interface Props {
	href: string;
	class?: string;
}

const { href, class: className } = Astro.props;
---

<a
	{href}
	{...linkAttributes(href)}
	data-astro-prefetch={isExternalLink(href) ? undefined : true}
	class={cn('text-accent underline decoration-accent', className)}
>
	<slot />
</a>
